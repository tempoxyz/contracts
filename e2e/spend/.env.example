# Copy to e2e/spend/.env.moderato for `pnpm --filter e2e spend:moderato`. Never commit the
# populated file.

# Tempo API key with Moderato Zone RPC access (the Zone RPC is api.tempo.xyz/rpc/<zone chain ID>).
TEMPO_API_KEY=

# The cardholder: a Moderato account the Zone 3 Portal has admitted (Portal Account role). A bounced
# withdrawal returns to it in the Zone. A return the Zone rejects goes to the program's
# refundRecipient in targets/moderato.json instead. The run funds it from the Moderato faucet.
CARDHOLDER_PRIVATE_KEY=

# Only for `--deploy`, or when targets/moderato.json has no settler and router: deploys the test
# card program (or its settler and router) and records it in targets/moderato.json, and allows the
# Earn vault for the program. The run funds it from the Moderato faucet. Use a test-only key.
DEPLOYER_PRIVATE_KEY=

# Only for `--admit`: grants the router, cardholder, program wallet and refund recipient the
# Zone 3 Portal roles they lack. It must be the Portal admin, or the sole owner of the threshold-1
# Safe that is.
ZONE_ADMIN_PRIVATE_KEY=
