# Shared template for profile deployment and hosted Earn E2E configuration.
# Every profile command loads `.env.<profile-id>`; for example, copy this to `.env.acme-mainnet` for
# `profiles/acme-mainnet/profile.json`. Commands that need a value fail, naming that file, when
# neither it nor the process environment supplies one. Replace TEMPO_RPC_URL with
# `https://rpc.moderato.tempo.xyz/` for Moderato. Replace the public fixture identities below for
# non-throwaway use. Never fund the checked-in keys with real value or commit populated files.
TEMPO_RPC_URL=https://rpc.tempo.xyz/

# Preferred hosted Zone gateway access. When set, TEMPO_API_KEY takes precedence over
# ZONE_RPC_URL. The E2E runner still creates its short-lived account authorization tokens.
TEMPO_API_KEY=

# Alternative direct Zone RPC access. Leave TEMPO_API_KEY blank and configure the exact Zone URL.
# ZONE_RPC_URL=

# Deployment and setup authorities. These checked-in values are public test fixtures; never fund
# them with meaningful value.
# Required to deploy contracts, pay deployment gas, and act as the hosted E2E operator. Its
# derived address is the deployment account and the default final owner.
DEPLOYER_PRIVATE_KEY=0x19a6511ec6500f5f969658122547af3df9609f9dd72a3ecb57502699d68dfab9
# Optional distinct hosted E2E user and access administrator; each unset role signs with
# DEPLOYER_PRIVATE_KEY, and the run says so.
# END_USER_PRIVATE_KEY=
# EARN_ACCESS_ADMIN_PRIVATE_KEY=
# When the deployer is also the configured owner or an external authority, the same signer performs
# that setup. Otherwise the command emits an exact handoff for the external authority.
# Optional: enables missing Zone tokens in the same command; otherwise deployment emits a handoff.
ZONE_ADMIN_PRIVATE_KEY=
