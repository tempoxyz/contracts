# Copy to .env.local for local development or .env.production for a production-mode run.
# Never commit either file with real deployment settings.
#
# ENVIRONMENT, RPC URLs, and network-specific sponsor URLs are non-secret deployment settings
# owned by wrangler.jsonc, so they do not need to be duplicated here.

# Public Privy application identifier returned by /api/config.
PRIVY_APP_ID=cmixx4jol01zgl80cgjenqkps

# Worker-only key with Testnet Zone write scope, used for reads and the fixed Zone RPC.
TEMPO_API_KEY=
