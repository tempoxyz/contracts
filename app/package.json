{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "CLOUDFLARE_ENV=production vp build",
    "build:preview": "CLOUDFLARE_ENV=preview vp build",
    "check": "vp lint --deny-warnings && vp fmt --check",
    "check:types": "pnpm gen:types && tsc -b",
    "deployment:catalog": "tsx deployments/generate.ts",
    "dev": "vp dev",
    "dev:local": "tsx local/dev.ts",
    "gen:types": "wrangler types worker-configuration.d.ts",
    "test": "pnpm test:unit && pnpm test:worker",
    "test:unit": "vitest --run",
    "test:worker": "CLOUDFLARE_TEST_POOL=true vitest --run"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.49.0",
    "@tanstack/react-query": "catalog:",
    "@tempoxyz/earn": "workspace:*",
    "@xyflow/react": "12.12.0",
    "accounts": "0.19.1",
    "hono": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "regen-ui": "catalog:",
    "viem": "catalog:",
    "wagmi": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "localnet": "workspace:*",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vp": "catalog:",
    "wrangler": "catalog:"
  }
}
